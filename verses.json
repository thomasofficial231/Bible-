  { "mood": "lonely", "verse": "For the Lord loves justice, and he will never abandon the godly.", "reference": "Psalm 37:28" },
  { "mood": "lonely", "verse": "Draw near to God, and he will draw near to you.", "reference": "James 4:8" },
  { "mood": "lonely", "verse": "Fear not, for I have redeemed you; I have called you by name, you are mine.", "reference": "Isaiah 43:1" },
  { "mood": "lonely", "verse": "For I am convinced that neither death nor life, neither angels nor demons... will be able to separate us from the love of God.", "reference": "Romans 8:38-39" },
  { "mood": "lonely", "verse": "The Lord your God is in your midst, a mighty one who will save; he will rejoice over you with gladness.", "reference": "Zephaniah 3:17" },
  { "mood": "lonely", "verse": "Never will I leave you; never will I forsake you.", "reference": "Hebrews 13:5" },
  { "mood": "lonely", "verse": "You are the God who sees me.", "reference": "Genesis 16:13" },
  { "mood": "lonely", "verse": "He tends his flock like a shepherd; he gathers the lambs in his arms.", "reference": "Isaiah 40:11" },

  // ---------- NEED STRENGTH (15 verses) ----------
