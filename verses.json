  // ---------- SAD (15 verses) ----------
  { "mood": "sad", "verse": "The Lord is close to the brokenhearted and saves those who are crushed in spirit.", "reference": "Psalm 34:18" },
  { "mood": "sad", "verse": "He heals the brokenhearted and binds up their wounds.", "reference": "Psalm 147:3" },
  { "mood": "sad", "verse": "Weeping may stay for the night, but rejoicing comes in the morning.", "reference": "Psalm 30:5" },
  { "mood": "sad", "verse": "Come to me, all you who are weary and burdened, and I will give you rest.", "reference": "Matthew 11:28" },
  { "mood": "sad", "verse": "He will wipe every tear from their eyes. There will be no more death or mourning or crying or pain.", "reference": "Revelation 21:4" },
  { "mood": "sad", "verse": "The Lord is my shepherd, I lack nothing. He makes me lie down in green pastures.", "reference": "Psalm 23:1-2" },
  { "mood": "sad", "verse": "Why, my soul, are you downcast? Why so disturbed within me? Put your hope in God.", "reference": "Psalm 42:11" },
  { "mood": "sad", "verse": "Cast your cares on the Lord and he will sustain you; he will never let the righteous be shaken.", "reference": "Psalm 55:22" },
  { "mood": "sad", "verse": "Blessed are those who mourn, for they will be comforted.", "reference": "Matthew 5:4" },
  { "mood": "sad", "verse": "The God of all comfort, who comforts us in all our troubles.", "reference": "2 Corinthians 1:3-4" },
  { "mood": "sad", "verse": "You keep track of all my sorrows. You have collected all my tears in your bottle.", "reference": "Psalm 56:8" },
  { "mood": "sad", "verse": "He gives strength to the weary and increases the power of the weak.", "reference": "Isaiah 40:29" },
  { "mood": "sad", "verse": "For I am the Lord your God who takes hold of your right hand and says to you, Do not fear; I will help you.", "reference": "Isaiah 41:13" },
  { "mood": "sad", "verse": "Jesus wept.", "reference": "John 11:35" },
  { "mood": "sad", "verse": "The Lord your God is with you, the Mighty Warrior who saves. He will take great delight in you.", "reference": "Zephaniah 3:17" },

  // ---------- ANXIOUS / WORRIED (15 verses) ----------
  { "mood": "anxious", "verse": "Do not be anxious about anything, but in every situation, by prayer and petition, with thanksgiving, present your requests to God.", "reference": "Philippians 4:6" },
  { "mood": "anxious", "verse": "Cast all your anxiety on him because he cares for you.", "reference": "1 Peter 5:7" },
  { "mood": "anxious", "verse": "Peace I leave with you; my peace I give you. I do not give to you as the world gives. Do not let your hearts be troubled and do not be afraid.", "reference": "John 14:27" },
  { "mood": "anxious", "verse": "Do not worry about tomorrow, for tomorrow will worry about itself. Each day has enough trouble of its own.", "reference": "Matthew 6:34" },
  { "mood": "anxious", "verse": "And the peace of God, which transcends all understanding, will guard your hearts and your minds in Christ Jesus.", "reference": "Philippians 4:7" },
  { "mood": "anxious", "verse": "When anxiety was great within me, your consolation brought me joy.", "reference": "Psalm 94:19" },
  { "mood": "anxious", "verse": "Do not let your hearts be troubled. You believe in God; believe also in me.", "reference": "John 14:1" },
  { "mood": "anxious", "verse": "Look at the birds of the air; they do not sow or reap or store away in barns, and yet your heavenly Father feeds them. Are you not much more valuable than they?", "reference": "Matthew 6:26" },
  { "mood": "anxious", "verse": "The Lord himself goes before you and will be with you; he will never leave you nor forsake you. Do not be afraid; do not be discouraged.", "reference": "Deuteronomy 31:8" },
  { "mood": "anxious", "verse": "Humble yourselves, therefore, under God's mighty hand, that he may lift you up in due time.", "reference": "1 Peter 5:6" },
  { "mood": "anxious", "verse": "Trust in the Lord with all your heart and lean not on your own understanding; in all your ways submit to him.", "reference": "Proverbs 3:5-6" },
  { "mood": "anxious", "verse": "My God will meet all your needs according to the riches of his glory in Christ Jesus.", "reference": "Philippians 4:19" },
  { "mood": "anxious", "verse": "Which of you by being worried can add a single hour to his life?", "reference": "Matthew 6:27" },
  { "mood": "anxious", "verse": "I sought the Lord, and he answered me; he delivered me from all my fears.", "reference": "Psalm 34:4" },
  { "mood": "anxious", "verse": "For God has not given us a spirit of fear and timidity, but of power, love, and self-discipline.", "reference": "2 Timothy 1:7" },

  // ---------- AFRAID (15 verses) ----------
  { "mood": "fear", "verse": "Be strong and courageous. Do not be afraid; do not be discouraged, for the Lord your God will be with you wherever you go.", "reference": "Joshua 1:9" },
  { "mood": "fear", "verse": "The Lord is my light and my salvation — whom shall I fear? The Lord is the stronghold of my life — of whom shall I be afraid?", "reference": "Psalm 27:1" },
  { "mood": "fear", "verse": "When I am afraid, I put my trust in you.", "reference": "Psalm 56:3" },
  { "mood": "fear", "verse": "God is our refuge and strength, an ever-present help in trouble. Therefore we will not fear.", "reference": "Psalm 46:1-2" },
  { "mood": "fear", "verse": "Even though I walk through the darkest valley, I will fear no evil, for you are with me.", "reference": "Psalm 23:4" },
  { "mood": "fear", "verse": "There is no fear in love. But perfect love drives out fear.", "reference": "1 John 4:18" },
  { "mood": "fear", "verse": "So do not fear, for I am with you; do not be dismayed, for I am your God. I will strengthen you and help you.", "reference": "Isaiah 41:10" },
  { "mood": "fear", "verse": "The Lord is with me; I will not be afraid. What can mere mortals do to me?", "reference": "Psalm 118:6" },
  { "mood": "fear", "verse": "For I am the Lord your God who takes hold of your right hand and says to you, Do not fear; I will help you.", "reference": "Isaiah 41:13" },
  { "mood": "fear", "verse": "Have I not commanded you? Be strong and courageous. Do not be frightened; do not be dismayed.", "reference": "Joshua 1:9" },
  { "mood": "fear", "verse": "For you did not receive a spirit that makes you a slave again to fear, but you received the Spirit of sonship.", "reference": "Romans 8:15" },
  { "mood": "fear", "verse": "The Lord is my helper; I will not be afraid. What can mere mortals do to me?", "reference": "Hebrews 13:6" },
  { "mood": "fear", "verse": "Say to those with fearful hearts, 'Be strong, do not fear; your God will come.'", "reference": "Isaiah 35:4" },
  { "mood": "fear", "verse": "Do not be afraid of them, for I am with you and will rescue you, declares the Lord.", "reference": "Jeremiah 1:8" },
  { "mood": "fear", "verse": "Peace I leave with you; my peace I give you. Do not let your hearts be troubled and do not be afraid.", "reference": "John 14:27" },

  // ---------- LONELY (15 verses) ----------
  { "mood": "lonely", "verse": "And surely I am with you always, to the very end of the age.", "reference": "Matthew 28:20" },
  { "mood": "lonely", "verse": "The Lord himself goes before you and will be with you; he will never leave you nor forsake you.", "reference": "Deuteronomy 31:8" },
